# FinGate 자격 증명 — 이 파일은 템플릿이며 커밋된다. 실제 값은 .env에만 둔다.
# ECOS  https://ecos.bok.or.kr/api/   -> 인증키 신청
# DART  https://opendart.fss.or.kr/   -> 인증키 신청
ECOS_API_KEY=
DART_API_KEY=

# 에이전트 계층(fingate-ask)만 모델 자격 증명을 쓴다. 둘 중 하나만 있으면 된다.
# 나머지 기능과 CI 는 이 값 없이 전부 동작한다.
# Anthropic  https://console.anthropic.com/settings/keys
# Gemini     https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
